[Unit]
Description=Blockchain FastAPI Backend (Uvicorn)
Documentation=https://fastapi.tiangolo.com
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/blockchain/backend

# Use the virtual environment's Python/uvicorn
Environment="PATH=/var/www/blockchain/backend/.venv/bin"
EnvironmentFile=/var/www/blockchain/backend/.env

ExecStart=/var/www/blockchain/backend/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --log-level info

# Restart on failure
Restart=always
RestartSec=5

# Output to journal (view with: journalctl -u blockchain-backend)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blockchain-backend

[Install]
WantedBy=multi-user.target
