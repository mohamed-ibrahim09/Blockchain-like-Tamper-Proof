APP_NAME=Blockchain-like Tamper-Proof Logging System
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
CRYPTO_SOURCE_DIR=
STORAGE_DIR=
LOG_CHAIN_FILE=log_chain.jsonl
TAMPER_WARNING_FILE=tamper_warnings.jsonl
SEED_DEMO_DATA=true

# Authentication - CHANGE THIS TO A RANDOM 32-CHAR STRING IN PRODUCTION
SECRET_KEY=change-this-to-a-random-32-char-string-for-production
JWT_EXPIRE_MINUTES=1440

# Key rotation settings
KEY_TTL_DAYS=90

# Alert configuration (optional)
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Database settings
USE_SQLITE=true
